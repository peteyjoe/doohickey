/* Template rendered by build.rs for the selected flash capacity.
 * Firmware allocation is fixed; storage gets all remaining flash.
 * Based on Embassy's examples/rp235x/memory.x, without RAM-boot support.
 */
MEMORY
{
    FLASH : ORIGIN = @FLASH_BASE@, LENGTH = @FIRMWARE_SIZE@
    STORAGE : ORIGIN = @STORAGE_ORIGIN@, LENGTH = @STORAGE_SIZE@
    RAM   : ORIGIN = 0x20000000, LENGTH = 512K
    SRAM8 : ORIGIN = 0x20080000, LENGTH = 4K
    SRAM9 : ORIGIN = 0x20081000, LENGTH = 4K
}

__storage_start = ORIGIN(STORAGE);
__storage_end = ORIGIN(STORAGE) + LENGTH(STORAGE);

/* Keep the RP235x image definition near the vectors for boot ROM discovery. */
SECTIONS
{
    .start_block : ALIGN(4)
    {
        __start_block_addr = .;
        KEEP(*(.start_block));
        KEEP(*(.boot_info));
    } > FLASH
} INSERT AFTER .vector_table;

_stext = ALIGN(ADDR(.start_block) + SIZEOF(.start_block), ALIGNOF(.text));

/* Program information read by picotool. */
SECTIONS
{
    .bi_entries : ALIGN(4)
    {
        __bi_entries_start = .;
        KEEP(*(.bi_entries));
        . = ALIGN(4);
        __bi_entries_end = .;
    } > FLASH
} INSERT AFTER .text;

SECTIONS
{
    .end_block : ALIGN(4)
    {
        __end_block_addr = .;
        KEEP(*(.end_block));
    } > FLASH
} INSERT AFTER .uninit;

PROVIDE(start_to_end = __end_block_addr - __start_block_addr);
PROVIDE(end_to_start = __start_block_addr - __end_block_addr);
